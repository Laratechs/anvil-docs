---
// The text links from `header` in site.structure.mjs, shown beside the site
// title by Header.astro. Words and targets come from the structure; this
// file is only markup and style.
import { header } from '~structure';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  header.length > 0 && (
    <nav class="header-links" aria-label="Site">
      {header.map((l) => (
        <a href={`${base}/${l.link}`}>{l.label}</a>
      ))}
    </nav>
  )
}

<style>
  .header-links {
    display: flex;
    gap: 1rem;
  }
  .header-links a {
    color: var(--anvil-text-muted);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .header-links a:hover {
    color: var(--anvil-text);
  }
</style>
