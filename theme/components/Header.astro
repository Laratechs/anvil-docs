---
// Replaces Starlight's Header: site title and the text links from `header`
// in site.structure.mjs on the left; search, social icons and the theme
// picker on the right. Mirrors Starlight's own Header.astro (0.42) apart
// from the layout.
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import HeaderLinks from './HeaderLinks.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="left-group sl-flex">
    <div class="title-wrapper sl-flex"><SiteTitle /></div>
    <div class="sl-hidden md:sl-flex print:hidden"><HeaderLinks /></div>
  </div>
  <div class="right-group sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
    <div class="sl-hidden md:sl-flex right-icons">
      <div class="sl-flex social-icons"><SocialIcons /></div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }
  .left-group {
    gap: 1.5rem;
    align-items: center;
    min-width: 0;
  }
  .title-wrapper {
    /* Keep long titles from covering the search and menu buttons. */
    overflow: clip;
    /* Don't clip the focus ring around the title link. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
  .right-group,
  .right-icons,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
</style>
